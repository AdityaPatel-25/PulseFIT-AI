{
	"info": {
		"_postman_id": "pulsefit-api-gateway-v1",
		"name": "PulseFIT AI - API Gateway (:8080)",
		"description": "Complete Postman collection for testing PulseFIT AI Microservices through Spring Cloud API Gateway (Port 8080). Includes automated JWT token extraction.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Authentication (Auth Service)",
			"item": [
				{
					"name": "Login as Admin (Extracts JWT)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if(jsonData.token) {",
									"    pm.environment.set(\"jwt_token\", jsonData.token);",
									"    console.log(\"Saved JWT token for user: \" + jsonData.username);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/login",
							"host": ["{{base_url}}"],
							"path": ["api", "auth", "login"]
						}
					}
				},
				{
					"name": "Login as Staff (staff_john)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
